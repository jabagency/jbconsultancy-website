---
/**
 * Closing call to action, repeated at the foot of every page.
 *
 * Offers both a form route and a WhatsApp route, because enterprise buyers and
 * founders reach for very different channels. The WhatsApp button disappears
 * entirely while the number is unconfigured.
 */
import Container from '@components/layout/Container.astro';
import Button from '@components/ui/Button.astro';
import { site } from '@data/site';
import { buildWhatsAppUrl } from '@lib/whatsapp';

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = 'Let us talk about what you are building.',
  lead = 'Tell us the outcome you need — whether that is a team to hire, a platform to ship, or a system to modernise. We will come back with a concrete route to get there.',
} = Astro.props;

const whatsappUrl = buildWhatsAppUrl({
  phone: site.contact.whatsapp,
  message: `Hi ${site.name}, I would like to discuss a project.`,
});
---

<section class="bg-subtle border-hairline border-t">
  <Container class="py-section">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="text-display-md text-ink">{title}</h2>
      <p class="text-lead text-body mt-4">{lead}</p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <Button href="/contact/" variant="primary" size="lg" icon="arrow-right">
          Contact Us
        </Button>
        {
          whatsappUrl && (
            <Button href={whatsappUrl} variant="whatsapp" size="lg" iconStart="whatsapp" external>
              Chat on WhatsApp
            </Button>
          )
        }
      </div>
    </div>
  </Container>
</section>
